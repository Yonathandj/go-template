# Copy to .env. Values here override configs/config.yaml, so keep real secrets
# out of the YAML and set them here (or as real environment variables).
#
# The variable name is the config path, uppercased, with _ between segments:
#   databases.postgres.example.password -> DATABASES_POSTGRES_EXAMPLE_PASSWORD
# The key must already exist in configs/config.yaml, otherwise it is ignored.

APP_ENV=development # development, staging, or production

SERVER_MODE=debug # test, debug, or release

DATABASES_POSTGRES_EXAMPLE_USER=postgres
DATABASES_POSTGRES_EXAMPLE_PASSWORD=postgres

REDIS_EXAMPLE_PASSWORD=

SERVICES_EXAMPLE_AUTH_USER=
SERVICES_EXAMPLE_AUTH_PASSWORD=
